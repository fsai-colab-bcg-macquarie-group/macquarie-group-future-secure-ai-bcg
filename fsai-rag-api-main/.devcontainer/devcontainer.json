{
    "name": "Dev Container - FSAI HyperRAG API",
    "build": {
      "dockerfile": "Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/fsai_rag_api,type=bind",
    "workspaceFolder": "/home/fsai_rag_api",
    "runArgs": [
      "--env-file", ".devcontainer/devcontainer.env",
      "-e", "PYTHONPATH=/home/fsai_rag_api"
    ],
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-vscode-remote.remote-wsl",
          "GitHub.copilot",
          "DavidAnson.vscode-markdownlint",
          "eamodio.gitlens",
          "ms-azuretools.vscode-docker",
          "ms-python.vscode-pylance",
          "ms-python.debugpy"
        ],
        "settings": {
          "terminal.integrated.profiles.linux": {
            "bash": {
              "path": "/bin/bash"
            }
          },
          "terminal.integrated.defaultProfile.linux": "bash",
          "extensions.verifySignature": false,
          "explorer.compactFolders": false,
          "dev.containers.mountWaylandSocket": false
        }
      }
    },
    "postCreateCommand": "pip install git+ssh://git@github.com/Future-Secure-AI/fsai_rag.git",
    "mounts": [
  "source=${env:HOME}/.ssh,target=/root/.ssh,type=bind"
]
}
